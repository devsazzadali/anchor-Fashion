  created_at DateTime? @default(now()) @db.Timestamptz(6)
}

model support_agents {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id              String?   @db.Uuid
  is_online            Boolean?  @default(false)
  active_tickets_count Int?      @default(0)
  created_at           DateTime? @default(now()) @db.Timestamptz(6)
}

model system_alerts {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  level       String?   @default("INFO") @db.VarChar(20)
  title       String    @db.VarChar(255)
  message     String?
  module      String?   @db.VarChar(50)
  is_resolved Boolean?  @default(false)
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
}

model ticket_attachments {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticket_id  String?   @db.Uuid
  message_id String?   @db.Uuid
  file_url   String
  file_name  String?   @db.VarChar(255)
  file_size  Int?
  created_at DateTime? @default(now()) @db.Timestamptz(6)
}

model wallet_transactions {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wallet_id        String?           @db.Uuid
  type             String            @db.VarChar(20)
  amount           Decimal           @db.Decimal(12, 2)
  balance_after    Decimal           @db.Decimal(12, 2)
  reference_type   String?           @db.VarChar(50)
  reference_id     String?           @db.VarChar(100)
  description      String?
  created_at       DateTime?         @default(now()) @db.Timestamptz(6)
  customer_wallets customer_wallets? @relation(fields: [wallet_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([wallet_id], map: "idx_wallet_transactions_wallet_id")
}

model warehouse_bins {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  zone_id          String?          @db.Uuid
  name             String?          @db.VarChar(255)
  code             String           @db.VarChar(50)
  barcode          String?          @db.VarChar(100)
  capacity_volume  Decimal?         @db.Decimal(10, 2)
  capacity_weight  Decimal?         @db.Decimal(10, 2)
  maximum_capacity Int?             @default(100)
  current_quantity Int?             @default(0)
  status           String?          @default("ACTIVE") @db.VarChar(50)
  created_at       DateTime?        @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?        @default(now()) @db.Timestamptz(6)
  warehouse_zones  warehouse_zones? @relation(fields: [zone_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([zone_id], map: "idx_warehouse_bins_zone_id")
}

model warehouse_zones {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  warehouse_id   String?          @db.Uuid
  name           String           @db.VarChar(255)
  code           String?          @db.VarChar(50)
  type           String?          @default("STORAGE") @db.VarChar(50)
  status         String?          @default("ACTIVE") @db.VarChar(50)
  is_active      Boolean?         @default(true)
  description    String?
  created_at     DateTime?        @default(now()) @db.Timestamptz(6)
  updated_at     DateTime?        @default(now()) @db.Timestamptz(6)
  warehouse_bins warehouse_bins[]
  warehouses     Warehouse?       @relation(fields: [warehouse_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([warehouse_id], map: "idx_warehouse_zones_warehouse_id")
}
