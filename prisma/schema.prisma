generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String?            @unique
  firstName       String?            @map("first_name")
  lastName        String?            @map("last_name")
  phone           String?
  phoneVerifiedAt DateTime?          @map("phone_verified_at") @db.Timestamptz(6)
  claimedAt       DateTime?          @map("claimed_at") @db.Timestamptz(6)
  avatarUrl       String?            @map("avatar_url")
  roleId          String?            @map("role_id") @db.Uuid
  isActive        Boolean            @default(true) @map("is_active")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  auditLogs       AuditLog[]
  logs            CommunicationLog[]
  addresses       CustomerAddress[]
  customer        Customer?
  notifications   Notification[]
  orders          Order[]
  role            Role?              @relation(fields: [roleId], references: [id])
  reviews         Review[]
  assignedTickets SupportTicket[]    @relation("TicketAssignee")
  assignedTasks   Task[]             @relation("TaskAssignee")
  createdTasks    Task[]             @relation("TaskCreator")
  sentMessages    TicketMessage[]
  bookmarks       UserBookmark[]

  @@index([phone], map: "idx_profiles_phone")
  @@index([roleId], map: "idx_profiles_role_id")
  @@map("profiles")
}

model Role {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  profiles    Profile[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String           @unique
  name        String
  module      String
  description String?
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId], map: "idx_role_permissions_role_perm_unique")
  @@index([permissionId], map: "idx_role_permissions_permission_id")
  @@map("role_permissions")
}

model UserBookmark {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  label     String
  href      String
  icon      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, href])
  @@map("user_bookmarks")
}

model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?   @map("user_id") @db.Uuid
  title     String
  message   String
  type      String    @default("system")
  linkUrl   String?   @map("link_url")
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      Profile?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model Task {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  description String?
  status      String    @default("pending")
  priority    String    @default("medium")
  assigneeId  String?   @map("assignee_id") @db.Uuid
  createdById String?   @map("created_by") @db.Uuid
  dueDate     DateTime? @map("due_date") @db.Timestamptz(6)
  isDeleted   Boolean   @default(false) @map("is_deleted")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  assignee    Profile?  @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creator     Profile?  @relation("TaskCreator", fields: [createdById], references: [id])

  @@index([assigneeId], map: "idx_tasks_assignee_id")
  @@index([createdById], map: "idx_tasks_created_by")
  @@map("tasks")
}

model Category {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  slug              String            @unique
  description       String?
  imageUrl          String?           @map("image_url")
  parentId          String?           @map("parent_id") @db.Uuid
  displayOrder      Int               @default(0) @map("display_order")
  isActive          Boolean           @default(true) @map("is_active")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  parent            Category?         @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children          Category[]        @relation("CategoryHierarchy")
  productCategories ProductCategory[]
  products          Product[]

  @@index([parentId], map: "idx_categories_parent_id")
  @@map("categories")
}

model Brand {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  slug        String    @unique
  logoUrl     String?   @map("logo_url")
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  products    Product[]

  @@map("brands")
}

model Tag {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String       @unique
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  products  ProductTag[]

  @@map("tags")
}

model Product {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  slug              String            @unique
  description       String?
  shortDescription  String?           @map("short_description")
  basePrice         Decimal           @default(0) @map("base_price") @db.Decimal(12, 2)
  costPrice         Decimal?          @map("cost_price") @db.Decimal(12, 2)
  salePrice         Decimal?          @map("sale_price") @db.Decimal(12, 2)
  vatPercent        Decimal           @default(0) @map("vat_percent") @db.Decimal(5, 2)
  sku               String?           @unique
  barcode           String?           @unique
  status            String            @default("DRAFT")
  gender            String?
  season            String?
  careInstructions  String?           @map("care_instructions")
  countryOfOrigin   String?           @map("country_of_origin")
  isFeatured        Boolean           @default(false) @map("is_featured")
  isNewArrival      Boolean           @default(false) @map("is_new_arrival")
  rating            Decimal           @default(0) @db.Decimal(3, 2)
  reviewCount       Int               @default(0) @map("review_count")
  imageUrl          String?           @map("image_url")
  galleryUrls       String[]          @default([]) @map("gallery_urls")
  categoryId        String?           @map("category_id") @db.Uuid
  brandId           String?           @map("brand_id") @db.Uuid
  tags              String[]          @default([])
  deletedAt         DateTime?         @map("deleted_at") @db.Timestamptz(6)
  preTrashStatus    String?           @map("pre_trash_status")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  cartItems         CartItem[]
  orderItems        OrderItem[]
  productCategories ProductCategory[]
  media             ProductMedia[]
  seo               ProductSeo?
  productTags       ProductTag[]
  brand             Brand?            @relation(fields: [brandId], references: [id])
  category          Category?         @relation(fields: [categoryId], references: [id])
  reviews           Review[]
  variants          Variant[]
  wishlistItems     WishlistItem[]

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([deletedAt])
  @@index([createdAt(sort: Desc)], map: "idx_products_created_at_desc")
  @@index([isFeatured], map: "idx_products_is_featured")
  @@map("products")
}

model ProductCategory {
  productId  String   @map("product_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

model ProductMedia {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  variantId    String?  @map("variant_id") @db.Uuid
  url          String
  urlWebp      String?  @map("url_webp")
  altText      String?  @map("alt_text")
  displayOrder Int      @default(0) @map("display_order")
  isPrimary    Boolean  @default(false) @map("is_primary")
  mediaType    String   @default("IMAGE") @map("media_type")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant      Variant? @relation(fields: [variantId], references: [id])

  @@index([productId])
  @@index([variantId], map: "idx_product_media_variant_id")
  @@map("product_media")
}

model ProductSeo {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId       String   @unique @map("product_id") @db.Uuid
  metaTitle       String?  @map("meta_title")
  metaDescription String?  @map("meta_description")
  canonicalUrl    String?  @map("canonical_url")
  ogTitle         String?  @map("og_title")
  ogDescription   String?  @map("og_description")
  ogImageUrl      String?  @map("og_image_url")
  twitterCardType String?  @map("twitter_card_type")
  structuredData  Json?    @map("structured_data")
  keywords        String[] @default([])
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_seo")
}

model ProductTag {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  tagId     String   @map("tag_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([productId, tagId])
  @@index([tagId], map: "idx_product_tags_tag_id")
  @@map("product_tags")
}

model Variant {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId       String              @map("product_id") @db.Uuid
  sku             String              @unique
  barcode         String?             @unique
  priceOverride   Decimal?            @map("price_override") @db.Decimal(12, 2)
  salePrice       Decimal?            @map("sale_price") @db.Decimal(12, 2)
  costPrice       Decimal?            @map("cost_price") @db.Decimal(12, 2)
  weight          Decimal?            @db.Decimal(8, 2)
  attributes      Json                @default("{}")
  isActive        Boolean             @default(true) @map("is_active")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  cartItems       CartItem[]
  inventoryLevels InventoryLevel[]
  orderItems      OrderItem[]
  pickListItems   PickListItem[]
  media           ProductMedia[]
  poItems         PurchaseOrderItem[]
  returnItems     ReturnItem[]
  stockMovements  StockMovement[]
  branchTransfers BranchTransfer[]
  product         Product             @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("variants")
}

model Warehouse {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  code            String            @unique
  address         String?
  city            String?
  state           String?
  postalCode      String?           @map("postal_code")
  country         String?           @default("BD")
  latitude        Float?
  longitude       Float?
  capacity        Int?
  isActive        Boolean           @default(true) @map("is_active")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  inventoryLevels InventoryLevel[]
  pickLists       PickList[]
  purchaseOrders  PurchaseOrder[]
  stockMovements  StockMovement[]
  branchTransfers BranchTransfer[]
  warehouse_zones warehouse_zones[]

  @@map("warehouses")
}

model InventoryLevel {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  variantId         String    @map("variant_id") @db.Uuid
  warehouseId       String    @map("warehouse_id") @db.Uuid
  quantityAvailable Int       @default(0) @map("quantity_available")
  quantityReserved  Int       @default(0) @map("quantity_reserved")
  reorderPoint      Int       @default(5) @map("reorder_point")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  variant           Variant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse         Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([variantId, warehouseId])
  @@index([warehouseId], map: "idx_inventory_levels_warehouse_id")
  @@map("inventory_levels")
}

model StockMovement {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  variantId        String    @map("variant_id") @db.Uuid
  warehouseId      String    @map("warehouse_id") @db.Uuid
  movementType     String    @map("movement_type")
  quantity         Int
  previousQuantity Int       @map("previous_quantity")
  newQuantity      Int       @map("new_quantity")
  referenceType    String?   @map("reference_type")
  referenceId      String?   @map("reference_id")
  notes            String?
  createdBy        String?   @map("created_by") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  variant          Variant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse        Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([createdAt(sort: Desc)], map: "idx_stock_movements_created_at")
  @@index([variantId], map: "idx_stock_movements_variant_id")
  @@index([warehouseId], map: "idx_stock_movements_warehouse_id")
  @@map("stock_movements")
}

model Supplier {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  code           String          @unique
  contactName    String?         @map("contact_name")
  email          String?
  phone          String?
  address        String?
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model Customer {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId   String?           @unique @map("profile_id") @db.Uuid
  name        String
  email       String            @unique
  phone       String?
  address     String?
  groupId     String?           @map("group_id") @db.Uuid
  status      String            @default("active")
  notes       String?
  totalSpent  Decimal           @default(0) @map("total_spent") @db.Decimal(12, 2)
  ordersCount Int               @default(0) @map("orders_count")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  addresses   CustomerAddress[]
  group       CustomerGroup?    @relation(fields: [groupId], references: [id])
  profile     Profile?          @relation(fields: [profileId], references: [id])
  orders      Order[]
  returns     Return[]

  @@index([groupId], map: "idx_customers_group_id")
  @@map("customers")
}

model CustomerGroup {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String     @unique
  description String?
  isDynamic   Boolean    @default(false) @map("is_dynamic")
  rules       Json       @default("{}")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  customers   Customer[]

  @@map("customer_segments")
}

model CustomerAddress {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId  String?   @map("customer_id") @db.Uuid
  profileId   String?   @map("profile_id") @db.Uuid
  title       String    @default("Home")
  name        String
  phone       String
  addressLine String    @map("address_line")
  city        String
  state       String?
  postalCode  String?   @map("postal_code")
  country     String    @default("Bangladesh")
  isDefault   Boolean   @default(false) @map("is_default")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  profile     Profile?  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([customerId], map: "idx_customer_addresses_customer_id")
  @@index([profileId], map: "idx_customer_addresses_profile_id")
  @@map("customer_addresses")
}

model Order {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderNumber     String               @unique @map("order_number")
  invoiceToken    String?              @unique @map("invoice_token")
  customerId      String?              @map("customer_id") @db.Uuid
  profileId       String?              @map("profile_id") @db.Uuid
  status          String               @default("PENDING")
  paymentStatus   String               @default("UNPAID") @map("payment_status")
  paymentMethod   String               @default("COD") @map("payment_method")
  paymentTxnId    String?              @map("payment_txn_id")
  subtotal        Decimal              @default(0) @db.Decimal(12, 2)
  discount        Decimal              @default(0) @db.Decimal(12, 2)
  vatAmount       Decimal              @default(0) @map("vat_amount") @db.Decimal(12, 2)
  shippingFee     Decimal              @default(0) @map("shipping_fee") @db.Decimal(12, 2)
  totalAmount     Decimal              @default(0) @map("total_amount") @db.Decimal(12, 2)
  couponCode      String?              @map("coupon_code")
  notes           String?
  shippingAddress Json                 @map("shipping_address")
  billingAddress  Json?                @map("billing_address")
  trackingNumber        String?              @map("tracking_number")
  courier               String?
  paidAt                DateTime?            @map("paid_at") @db.Timestamptz(6)
  cancelledAt           DateTime?            @map("cancelled_at") @db.Timestamptz(6)
  shippedAt             DateTime?            @map("shipped_at") @db.Timestamptz(6)
  deliveredAt           DateTime?            @map("delivered_at") @db.Timestamptz(6)
  reservationExpiresAt  DateTime?            @map("reservation_expires_at") @db.Timestamptz(6)
  riskLevel             String?              @map("risk_level") @db.VarChar(20)
  riskScore             Int?                 @map("risk_score")
  riskReasons           Json?                @map("risk_reasons")
  verificationStatus    String?              @map("verification_status") @db.VarChar(20)
  verificationVerifiedAt DateTime?           @map("verification_verified_at") @db.Timestamptz(6)
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  items           OrderItem[]
  statusHistory   OrderStatusHistory[]
  customer        Customer?            @relation(fields: [customerId], references: [id])
  profile         Profile?             @relation(fields: [profileId], references: [id])
  payments        Payment[]
  returns         Return[]
  shipments       Shipment[]

  @@index([customerId])
  @@index([profileId])
  @@index([createdAt(sort: Desc)], map: "idx_orders_created_at_desc")
  @@index([paymentStatus], map: "idx_orders_payment_status")
  @@index([status, createdAt(sort: Desc)], map: "idx_orders_status_created_at")
  @@index([reservationExpiresAt], map: "idx_orders_reservation_expiry")
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  productId   String?  @map("product_id") @db.Uuid
  variantId   String?  @map("variant_id") @db.Uuid
  productName String   @map("product_name")
  variantName String?  @map("variant_name")
  sku         String
  quantity    Int      @default(1)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  totalPrice  Decimal  @map("total_price") @db.Decimal(12, 2)
  /// True while this line's stock is held by InventoryService.reserveOrderInventory.
  /// Release/confirm only act on reserved lines, which makes them idempotent.
  inventoryReserved    Boolean  @default(false) @map("inventory_reserved")
  /// Warehouse the reservation was taken from (release/confirm target).
  allocatedWarehouseId String?  @map("allocated_warehouse_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id])
  variant     Variant? @relation(fields: [variantId], references: [id])

  @@index([orderId], map: "idx_order_items_order_id")
  @@index([productId], map: "idx_order_items_product_id")
  @@index([variantId], map: "idx_order_items_variant_id")
  @@map("order_items")
}

model OrderStatusHistory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  status    String
  notes     String?
  changedBy String?  @map("changed_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId], map: "idx_order_status_history_order_id")
  @@map("order_status_history")
}

model Payment {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId         String   @map("order_id") @db.Uuid
  amount          Decimal  @db.Decimal(12, 2)
  method          String
  status          String   @default("PENDING")
  transactionId   String?  @map("transaction_id")
