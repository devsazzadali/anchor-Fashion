# ==========================================
# Anchor Fashion - Production Environment Variables Template
# Copy this file to .env.local or .env in deployment environments
# ==========================================

# --- Application & Domain ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ENVIRONMENT=development

# --- Authentication & NextAuth ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_a_secure_random_32_character_secret_here

# --- Database (Neon PostgreSQL via Prisma) ---
DATABASE_URL=postgresql://[USER]:[PASSWORD]@[POOLER_HOST]/neondb?sslmode=require
DIRECT_URL=postgresql://[USER]:[PASSWORD]@[HOST]/neondb?sslmode=require

# --- COD Fraud Shield ---
# Optional dedicated HMAC secret for COD OTP hashing; falls back to NEXTAUTH_SECRET.
COD_OTP_HMAC_SECRET=

# --- Google Gemini AI Suite ---
GEMINI_API_KEY=AIzaSy...

# --- Email & Communication (Resend) ---
RESEND_API_KEY=re_...
EMAIL_FROM=orders@anchorfashion.com
NEXT_PUBLIC_EMAIL_FROM=support@anchorfashion.com
RESEND_WEBHOOK_SECRET=whsec_...

# --- Web Push Notifications (VAPID) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=B...
VAPID_PRIVATE_KEY=...

# --- Analytics & Telemetry ---
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_TAG_MANAGER_ID=GTM-XXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=123456789012345

# --- Payment Gateways: bKash Tokenized ---
BKASH_APP_KEY=your_bkash_app_key
BKASH_APP_SECRET=your_bkash_app_secret
BKASH_USERNAME=your_bkash_username
BKASH_PASSWORD=your_bkash_password

# --- Payment Gateways: SSLCommerz ---
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASSWORD=your_store_passwd
SSLCOMMERZ_STORE_PASSWD=your_store_passwd
SSLCOMMERZ_IS_SANDBOX=true

# --- Payment Gateways: Nagad ---
NAGAD_MERCHANT_ID=your_merchant_id
NAGAD_MERCHANT_NUMBER=your_merchant_phone_number
NAGAD_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
NAGAD_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# --- Payment Gateways: Stripe ---
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Payment Gateways: PayPal ---
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# --- Shipping & Logistics Carriers ---
FEDEX_API_KEY=your_fedex_api_key
DHL_API_KEY=your_dhl_api_key
UPS_API_KEY=your_ups_api_key

# --- Cache, Rate Limiting & Job Queue (Upstash Redis) ---
UPSTASH_REDIS_REST_URL=https://[YOUR_INSTANCE].upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# --- Error Monitoring & Observability (Sentry) ---
SENTRY_DSN=https://[KEY]@o[ORG].ingest.sentry.io/[PROJECT]

# --- Cron Jobs & Queue Security ---
CRON_SECRET=generate_a_secure_random_cron_secret_here

# --- SMS Gateway (Alpha SMS Bangladesh) ---
ALPHA_SMS_API_KEY=your_alpha_sms_api_key_here
SMS_ENABLED=true
SMS_TEST_MODE=false

# --- Courier Integrations (Bangladesh 3PL) ---
# Pathao
PATHAO_BASE_URL=https://courier-api-sandbox.pathao.com
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=

# Steadfast
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=

# Courier Credential Encryption (AES-256-GCM)
COURIER_ENCRYPTION_KEY=
ENCRYPTION_KEY=your_32_byte_base64_or_hex_encryption_key

# --- Media Storage (Workstream G) ---
# Production: STORAGE_DRIVER=vercel-blob + a Blob store token (Vercel
# dashboard → Storage → create Blob store → connect to this project; the
# token is injected automatically as BLOB_READ_WRITE_TOKEN). Uploaded
# media files live in Blob; the DB stores only the public URL.
# Local dev: leave STORAGE_DRIVER unset — uploads go to public/uploads/.
STORAGE_DRIVER=
BLOB_READ_WRITE_TOKEN=

# --- Neon Auth (Managed Better Auth) ---
# Phone-OTP login: secret of the webhook endpoint registered for this app
# in the Neon Console (Webhooks tab → endpoint /api/webhooks/neon-auth).
# When set, webhook signatures are verified (Standard Webhooks scheme).
NEON_AUTH_WEBHOOK_SECRET=
NEON_AUTH_BASE_URL=https://[YOUR_BRANCH_AUTH_URL]/neondb/auth
NEON_AUTH_JWKS_URL=https://[YOUR_BRANCH_AUTH_URL]/neondb/auth/.well-known/jwks.json
NEON_AUTH_COOKIE_SECRET=generate_a_secure_random_32_character_secret_here
