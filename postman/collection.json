        {
          "name": "Shipping Analytics",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/shipping/analytics",
              "host": ["{{baseUrl}}"],
              "path": ["api", "shipping", "analytics"]
            },
            "description": "Aggregates fulfillment times, courier SLA compliance, and delivery success rates."
          },
          "response": []
        }
      ]
    },
