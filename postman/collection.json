{
  "info": {
    "_postman_id": "anchor-fashion-api-collection-v1",
    "name": "Anchor Fashion API Collection",
    "description": "Comprehensive, production-grade Postman collection for Anchor Fashion eCommerce platform covering Storefront, Customer, Checkout, Payment Gateways, Shipping & Logistics, AI Suite, Admin Operations, Background Crons, and Webhooks.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Health & Observability",
      "item": [
        {
          "name": "System Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            },
            "description": "Checks system operational status, database connectivity, and environment uptime."
          },
          "response": []
        },
        {
          "name": "Observability Ingest",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"level\": \"info\",\n  \"event\": \"client_page_view\",\n  \"message\": \"Customer navigated to /products\",\n  \"context\": {\n    \"path\": \"/products\",\n    \"userAgent\": \"Mozilla/5.0\"\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/observability/ingest",
              "host": ["{{baseUrl}}"],
              "path": ["api", "observability", "ingest"]
            },
            "description": "Ingests client-side telemetries, operational logs, and performance metrics."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Authentication & Verification",
      "item": [
        {
          "name": "Send OTP (Email)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@example.com\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/otp/send",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "otp", "send"]
            },
            "description": "Sends a 6-digit one-time password to the specified email address with rate limiting and brute force protection."
          },
          "response": []
        },
        {
          "name": "Verify OTP (Email)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@example.com\",\n  \"code\": \"123456\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/otp/verify",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "otp", "verify"]
            },
            "description": "Verifies the email OTP and issues session / authentication token."
          },
          "response": []
        },
        {
          "name": "Send Registration OTP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newuser@example.com\",\n  \"full_name\": \"Jane Doe\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/send-register-otp",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "send-register-otp"]
            },
            "description": "Initiates user onboarding and sends verification code."
          },
          "response": []
        },
        {
          "name": "Verify Registration OTP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newuser@example.com\",\n  \"code\": \"123456\",\n  \"password\": \"SecurePass123!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/verify-register-otp",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "verify-register-otp"]
            },
            "description": "Completes registration and creates user profile."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Storefront Catalog",
      "item": [
        {
          "name": "List Store Products (Paginated)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/store/products?page=1&limit=12",
              "host": ["{{baseUrl}}"],
              "path": ["api", "store", "products"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "12" }
              ]
            },
            "description": "Fetches paginated list of active storefront products with variants and media."
          },
          "response": []
        },
        {
          "name": "Search & Filter Products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/store/products?search=shirt&category=apparel&minPrice=500&maxPrice=10000",
              "host": ["{{baseUrl}}"],
              "path": ["api", "store", "products"],
              "query": [
                { "key": "search", "value": "shirt" },
                { "key": "category", "value": "apparel" },
                { "key": "minPrice", "value": "500" },
                { "key": "maxPrice", "value": "10000" }
              ]
            },
            "description": "Filters products by search keywords, category slug, and price range."
          },
          "response": []
        }
      ]
    },
    {
      "name": "4. Orders & Checkout",
      "item": [
        {
          "name": "Get Customer Orders",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/store/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "store", "orders"]
            },
            "description": "Retrieves the authenticated customer's order history."
          },
          "response": []
        },
        {
          "name": "Create Store Order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_name\": \"Sophia Al-Rahman\",\n  \"customer_phone\": \"+8801712345678\",\n  \"customer_email\": \"customer@example.com\",\n  \"delivery_address\": \"House 14, Road 5, Dhanmondi\",\n  \"city\": \"Dhaka\",\n  \"payment_method\": \"COD\",\n  \"total_amount\": 3500,\n  \"delivery_fee\": 60,\n  \"items\": [\n    {\n      \"product_id\": \"{{productId}}\",\n      \"product_name\": \"Silk Evening Gown\",\n      \"quantity\": 1,\n      \"unit_price\": 3500\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/store/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "store", "orders"]
            },
            "description": "Places a new customer order with line items and delivery address."
          },
          "response": []
        },
        {
          "name": "Initialize Payment Gateway",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/payment/init?order_id={{orderId}}&method=BKASH",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payment", "init"],
              "query": [
                { "key": "order_id", "value": "{{orderId}}" },
                { "key": "method", "value": "BKASH" }
              ]
            },
            "description": "Initiates payment session for bKash, SSLCommerz, Stripe, or PayPal and redirects customer to the gateway."
          },
          "response": []
        },
        {
          "name": "bKash Payment Callback",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/payment/bkash/callback?paymentID=TEST_PAYMENT_ID&status=success",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payment", "bkash", "callback"],
              "query": [
                { "key": "paymentID", "value": "TEST_PAYMENT_ID" },
                { "key": "status", "value": "success" }
              ]
            },
            "description": "Handles return redirect from bKash, validates transaction amount and updates order."
          },
          "response": []
        },
        {
          "name": "SSLCommerz Payment Callback",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "status", "value": "VALID", "type": "text" },
                { "key": "tran_id", "value": "ORD-TEST-12345", "type": "text" },
                { "key": "val_id", "value": "VAL_TEST_9999", "type": "text" },
                { "key": "amount", "value": "3500.00", "type": "text" },
                { "key": "currency", "value": "BDT", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/payment/sslcommerz/callback?action=success",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payment", "sslcommerz", "callback"],
              "query": [
                { "key": "action", "value": "success" }
              ]
            },
            "description": "Handles return POST from SSLCommerz hosted gateway, verifies server signature, amount and currency."
          },
          "response": []
        }
      ]
    },
    {
